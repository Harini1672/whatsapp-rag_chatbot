# ============================================================
# BACKEND ENVIRONMENT VARIABLES
# Copy to .env and fill in your values
# ============================================================

# ── App ──────────────────────────────────────────────────────
APP_NAME="RAG ChatBot API"
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string

# ── Supabase ─────────────────────────────────────────────────
# Get from: supabase.com -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-service-role-key        # Service role (SECRET — backend only)
SUPABASE_ANON_KEY=your-anon-key          # Anon key (same as frontend)

# ── OpenAI ───────────────────────────────────────────────────
# Optional — only needed for Text-to-Speech (tts-1).
# All other AI features (LLM, embeddings, STT) now run locally via Hugging Face.
# If not set, TTS is gracefully disabled and text responses are used instead.
OPENAI_API_KEY=sk-...

# ── Pinecone ─────────────────────────────────────────────────
# Required for vector search.
# Get from: app.pinecone.io -> API Keys
#
# IMPORTANT: Create the new index manually in the Pinecone console:
#   Name:       rag-chatbot-hf
#   Dimensions: 384
#   Metric:     cosine
#   Type:       Serverless (AWS us-east-1)
#
# The old rag-chatbot index (1536 dims) is preserved and untouched.
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX_NAME=rag-chatbot-hf
PINECONE_ENVIRONMENT=us-east-1

# ── Hugging Face AI (all run locally — no API key required) ──────────────────
# LLM: Qwen3-4B (~8 GB RAM). First run downloads model weights (~8 GB).
# Fallback used automatically if primary model fails to load.
LLM_MODEL=Qwen/Qwen3-4B
LLM_FALLBACK_MODEL=Qwen/Qwen3-1.7B

# Embeddings: multilingual MiniLM — 384 dims, ~120 MB download
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384

# STT: local Whisper small — ~150 MB download, no GPU required
STT_MODEL=openai/whisper-small

# ── WasenderAPI ──────────────────────────────────────────────
# Required for real WhatsApp messaging ($6/month plan)
# Get from: wasenderapi.com
WASENDER_BASE_URL=https://api.wasenderapi.com/api

# ── Deployment ───────────────────────────────────────────────
# Your backend's public URL (for webhook URL generation)
# Development: use ngrok or localtunnel for HTTPS
BACKEND_URL=https://your-backend.onrender.com

# ── RAG Config ───────────────────────────────────────────────
# These values are unchanged from the original configuration.
MAX_TOKENS=1000
TOP_K_CHUNKS=5
CHUNK_SIZE=800
CHUNK_OVERLAP=100
